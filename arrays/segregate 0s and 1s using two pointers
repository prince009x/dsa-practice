//https://www.geeksforgeeks.org/problems/segregate-0s-and-1s5106/1
// segregate 0s and 1s using two pointers
class Solution {
	public:
	void segregate0and1(vector<int> &arr) {
		int left = 0 ;
		int right = arr.size() - 1;
		
		while (left < right) {
			
			if (arr[left] == 0) {
				left++;
			}
			else if (arr[right] == 1) {
				right--;
			}
			
			else {
				int temp = arr[left];
				arr[left] = arr[right];
				arr[right] = temp;
				
				left++;
				right--;
				
			}
			
		}
	}
};
